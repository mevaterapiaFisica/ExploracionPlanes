<local:DialogoWpf x:Class="ExploracionPlanes.FormConfiguracion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ExploracionPlanes"
        Title="Configuración" Height="220" Width="500"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F7F8FA" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style x:Key="BotonPrimario" TargetType="Button">
            <Setter Property="Background" Value="#1B2A4A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="18,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="BotonSecundario" TargetType="Button" BasedOn="{StaticResource BotonPrimario}">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#1B2A4A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#1B2A4A" />
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Ruta carpetas:" VerticalAlignment="Center" />
        <TextBox x:Name="TB_Ruta" Grid.Row="0" Grid.Column="1" Margin="0,0,10,0" Padding="4" VerticalContentAlignment="Center" />
        <Button x:Name="BT_SeleccionarRuta" Grid.Row="0" Grid.Column="2" Content="Seleccionar" Style="{StaticResource BotonSecundario}" Click="BT_SeleccionarRuta_Click" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Volumen dosis máxima:" VerticalAlignment="Center" />
        <TextBox x:Name="TB_VolumenDM" Grid.Row="2" Grid.Column="1" Padding="4" VerticalContentAlignment="Center" HorizontalAlignment="Left" Width="90" />
        <TextBlock Grid.Row="2" Grid.Column="2" Text="[cm³]" VerticalAlignment="Center" Margin="8,0,0,0" />

        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="BT_Guardar" Content="Guardar" Style="{StaticResource BotonPrimario}" Click="BT_Guardar_Click" Margin="0,0,12,0" />
            <Button x:Name="BT_Cancelar" Content="Cancelar" Style="{StaticResource BotonSecundario}" Click="BT_Cancelar_Click" />
        </StackPanel>
    </Grid>
</local:DialogoWpf>
