    <Compile Include="..\..\MemoriaPlan.cs" Link="produccion\MemoriaPlan.cs" />
    <Compile Include="..\..\IO.cs" Link="produccion\IO.cs" />
    <Compile Include="..\..\Configuracion.cs" Link="produccion\Configuracion.cs" />
    <Compile Include="..\..\DatosEdicionRestriccion.cs" Link="produccion\DatosEdicionRestriccion.cs" />
    <Compile Include="..\..\RestriccionDosis.cs" Link="produccion\RestriccionDosis.cs" />
