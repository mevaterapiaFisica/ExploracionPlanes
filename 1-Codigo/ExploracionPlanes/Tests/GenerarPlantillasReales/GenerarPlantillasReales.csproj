<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- Codigo de produccion sin nullable annotations; no queremos warnings-como-nada raros -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StubEsapi\StubEsapi.csproj" />
  </ItemGroup>

  <!-- Compila el codigo de produccion TAL CUAL (sin copiarlo/reimplementarlo) contra el stub de ESAPI.
       DesdeCSV.GenerarPlantillasUnificadas nunca invoca los metodos que dependen de ESAPI real. -->
