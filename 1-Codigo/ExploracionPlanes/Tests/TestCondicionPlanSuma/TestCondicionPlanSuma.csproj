<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StubEsapi\StubEsapi.csproj" />
  </ItemGroup>

  <!-- Compila Condicion.cs de produccion TAL CUAL contra el stub de ESAPI (mismo patron que
       GenerarPlantillasReales), para reproducir el bug real: CumpleCondicion con tipo NumFx
       sobre un PlanSum casteaba directo a PlanSetup y tiraba InvalidCastException. -->
  <ItemGroup>
    <Compile Include="..\..\Condicion.cs" Link="produccion\Condicion.cs" />
    <Compile Include="..\..\EsapiCompat.cs" Link="produccion\EsapiCompat.cs" />
  </ItemGroup>

</Project>
