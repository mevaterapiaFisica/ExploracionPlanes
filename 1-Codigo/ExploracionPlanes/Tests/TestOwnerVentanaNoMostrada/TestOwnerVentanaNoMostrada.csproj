<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <!-- Compila DialogoWpf.cs de produccion TAL CUAL (no ESAPI, no requiere StubEsapi) para reproducir
       el escenario real: Main abre un dialogo hijo (FormChequeos) desde su PROPIO constructor, antes
       de que Main misma haya sido mostrada. -->
  <ItemGroup>
    <Compile Include="..\..\DialogoWpf.cs" Link="produccion\DialogoWpf.cs" />
  </ItemGroup>

</Project>
